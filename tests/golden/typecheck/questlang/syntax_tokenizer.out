(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('location') : 'Location')
        (TypedImportItem ('diagbag') : 'DiagBag')
        (TypedImportItem ('tokens') : 'Tokens')
        (TypedImportItem ('tokenizer') : 'Tokenizer')
        (TypedImportItem ('writer') : 'Writer')
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'wOut' :type Writer.T
      :value (TypedSelect 'output' :type Writer.T
        :target (TypedVar 'writer' :type Record error: Exception output: Writer.T err: Writer.T file: Fun(name: String): Writer.T putString: Fun(writer: Writer.T string: String): Ok putChar: Fun(writer: Writer.T char: Char): Ok putSubString: Fun(writer: Writer.T string: String start: Int size: Int): Ok flush: Fun(writer: Writer.T): Ok close: Fun(writer: Writer.T): Ok end)))
    (TypedLetValue 'printStr' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedApp :type Ok
                :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
                  :target (TypedVar 'writer' :type Record error: Exception output: Writer.T err: Writer.T file: Fun(name: String): Writer.T putString: Fun(writer: Writer.T string: String): Ok putChar: Fun(writer: Writer.T char: Char): Ok putSubString: Fun(writer: Writer.T string: String start: Int size: Int): Ok flush: Fun(writer: Writer.T): Ok close: Fun(writer: Writer.T): Ok end))
                :args (
                  (TypedVar 'wOut' :type Writer.T)
                  (TypedVar 's' :type String)
                )))
          )
          :result (TypedApp :type Ok
            :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
              :target (TypedVar 'writer' :type Record error: Exception output: Writer.T err: Writer.T file: Fun(name: String): Writer.T putString: Fun(writer: Writer.T string: String): Ok putChar: Fun(writer: Writer.T char: Char): Ok putSubString: Fun(writer: Writer.T string: String start: Int size: Int): Ok flush: Fun(writer: Writer.T): Ok close: Fun(writer: Writer.T): Ok end))
            :args (
              (TypedVar 'wOut' :type Writer.T)
              (TypedString '\n' :type String)
            )))))
    (TypedLetValue 'printInt' :type Fun(n: Int): Ok
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Ok
        :body (TypedApp :type Ok
          :func (TypedVar 'printStr' :type Fun(s: String): Ok)
          :args (
            (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Record okay: Fun(): String bool: Fun(b: Bool): String int: Fun(n: Int): String real: Fun(r: Real): String char: Fun(c: Char): String string: Fun(s: String): String end))
              :args (
                (TypedVar 'n' :type Int)
              ))
          ))))
    (TypedLetValue 'printBool' :type Fun(b: Bool): Ok
      :value (TypedFun :params (('b' : Bool)) :type Fun(b: Bool): Ok
        :body (TypedApp :type Ok
          :func (TypedVar 'printStr' :type Fun(s: String): Ok)
          :args (
            (TypedApp :type String
              :func (TypedSelect 'bool' :type Fun(b: Bool): String
                :target (TypedVar 'conv' :type Record okay: Fun(): String bool: Fun(b: Bool): String int: Fun(n: Int): String real: Fun(r: Real): String char: Fun(c: Char): String string: Fun(s: String): String end))
              :args (
                (TypedVar 'b' :type Bool)
              ))
          ))))
    (TypedLetValue 'code1' :type String
      :value (TypedInfix '<>' :type String
        :left (TypedString '(* Sample Quest program *)\n' :type String)
        :right (TypedInfix '<>' :type String
          :left (TypedString 'let rec fact(n: Int): Int =\n' :type String)
          :right (TypedInfix '<>' :type String
            :left (TypedString '    if n <= 1 then\n' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedString '        1\n' :type String)
              :right (TypedInfix '<>' :type String
                :left (TypedString '    else\n' :type String)
                :right (TypedString '        { n * fact(n - 1) };\n' :type String)))))))
    (TypedLetValue 'sm1' :type location.SourceMap
      :value (TypedApp :type location.SourceMap
        :func (TypedSelect 'newSourceMap' :type Fun(file: String text: String): location.SourceMap
          :target (TypedVar 'location' :type Record newSourceMap: Fun(file: String text: String): SourceMap span: Fun(file: String startOffset: Int endOffset: Int): Tuple file: String startOffset: Int endOffset: Int end pointSpan: Fun(file: String offset: Int): Tuple file: String startOffset: Int endOffset: Int end file: Fun(sm: SourceMap): String text: Fun(sm: SourceMap): String lineCount: Fun(sm: SourceMap): Int locate: Fun(sm: SourceMap offset: Int): Tuple offset: Int line: Int col: Int end locateSpan: Fun(sm: SourceMap sp: Tuple file: String startOffset: Int endOffset: Int end): Tuple start: Tuple offset: Int line: Int col: Int end endPos: Tuple offset: Int line: Int col: Int end end getLine: Fun(sm: SourceMap lineNum: Int): String extractSnippet: Fun(sm: SourceMap sp: Tuple file: String startOffset: Int endOffset: Int end): String end))
        :args (
          (TypedString 'fact.quest' :type String)
          (TypedVar 'code1' :type String)
        )))
    (TypedLetValue 'bag1' :type diagbag.T
      :value (TypedApp :type diagbag.T
        :func (TypedSelect 'new' :type Fun(): diagbag.T
