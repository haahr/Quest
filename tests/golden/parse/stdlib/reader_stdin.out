(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('reader') 'Reader')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 'r'
      :value (ExprSelect
        :target (ExprId 'reader')
        :field 'input'
      )
    )
    (LetValueBinding
      :name 'm'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'more'
        )
        :args (
          (ExprId 'r')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
