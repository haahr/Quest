        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'printStr')
        :args (
          (ExprSelect
            :target (ExprId 't2')
            :field 'lexeme'
          )
        )
      )
    )
    (LetValueBinding
      :name 'code3'
      :value (ExprInfix
        :left (ExprString '0 42 ~100 3.14 1.5e-3 ~2.0E+2\n' '"0 42 ~100 3.14 1.5e-3 ~2.0E+2\\n"')
        :op '<>'
        :right (ExprInfix
          :left (ExprString "'a' '\\n' '\\t' '\\'' '\\\\' '\\x41' '\\065'\n" '"\'a\' \'\\\\n\' \'\\\\t\' \'\\\\\'\' \'\\\\\\\\\' \'\\\\x41\' \'\\\\065\'\\n"')
          :op '<>'
          :right (ExprInfix
            :left (ExprString '"hello" "with \\"quotes\\" and \\n newline"\n' '"\\"hello\\" \\"with \\\\\\"quotes\\\\\\" and \\\\n newline\\"\\n"')
            :op '<>'
            :right (ExprInfix
              :left (ExprString '(* outer (* nested level 2 (* nested 3 *) *) back *)\n' '"(* outer (* nested level 2 (* nested 3 *) *) back *)\\n"')
              :op '<>'
              :right (ExprString 'ident_1 _validIdent == !=\n' '"ident_1 _validIdent == !=\\n"')
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'sm3'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'location')
          :field 'newSourceMap'
        )
        :args (
          (ExprString 'literals.quest' '"literals.quest"')
          (ExprId 'code3')
        )
      )
    )
    (LetValueBinding
      :name 'bag3'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'diagbag')
          :field 'new'
        )
      )
    )
    (LetValueBinding
