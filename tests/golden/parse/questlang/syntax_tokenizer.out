        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'tokens')
              :field 'tokenKindName'
            )
            :args (
              (ExprSelect
                :target (ExprId 'p2')
                :field 'kind'
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'printStr')
        :args (
          (ExprSelect
            :target (ExprId 'p2')
            :field 'lexeme'
          )
        )
      )
    )
    (LetValueBinding
      :name 't2'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'tokenizer')
          :field 'nextToken'
        )
        :args (
          (ExprId 'tk2')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'printStr')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'tokens')
              :field 'tokenKindName'
            )
            :args (
              (ExprSelect
                :target (ExprId 't2')
                :field 'kind'
              )
            )
