              :field 'hasErrors'
            )
            :args (
              (ExprId 'bag3')
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'codeErr'
      :value (ExprInfix
        :left (ExprString 'let valid = 1;\n' '"let valid = 1;\\n"')
        :op '<>'
        :right (ExprInfix
          :left (ExprString '"unclosed string literal\n' '"\\"unclosed string literal\\n"')
          :op '<>'
          :right (ExprInfix
            :left (ExprString 'let alsoValid = 2;\n' '"let alsoValid = 2;\\n"')
            :op '<>'
            :right (ExprInfix
              :left (ExprString "'\\z' (* invalid char escape *)\n" '"\'\\\\z\' (* invalid char escape *)\\n"')
              :op '<>'
              :right (ExprInfix
                :left (ExprString "'too long'\n" '"\'too long\'\\n"')
                :op '<>'
                :right (ExprString 'let final = 3;\n' '"let final = 3;\\n"')
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'smErr'
      :value (ExprApp
        :func (ExprSelect
