    (LetValueBinding
      :name 'tokens3'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'tokenizer')
          :field 'tokenizeAll'
        )
        :args (
          (ExprId 'tk3')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'printStr')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'tokenizer')
              :field 'formatDump'
            )
            :args (
              (ExprId 'tokens3')
              (ExprId 'sm3')
              (ExprBool False)
            )
          )
