(* Language: Array Literals, Indexing, Size, Repetition, and Loops *)

import arrayOp: ArrayOp;
import writer: Writer;
import conv: Conv;

let wOut = writer.output;
let printInt(x: Int): Ok =
    begin
        writer.putString(wOut conv.int(x));
        writer.putString(wOut "\n")
    end;

(* 1. Array literal and indexing *)
let a1 = array of 10 20 30 40 50 end;
printInt(a1[0]);
printInt(a1[4]);

(* 2. Array size and repetition *)
let a2 = array of(5 77);
printInt(arrayOp.size(:Int a2));
printInt(a2[2]);

(* 3. Array mutation *)
a1[2] := 999;
printInt(a1[2]);

(* 4. Array in loop *)
let var sum = 0;
for i = 0 upto 4 do
    sum := sum + a1[i]
end;
printInt(sum);
