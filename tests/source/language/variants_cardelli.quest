(* Language: Cardelli 6.3 Unordered Variants, Width Subtyping, ? and ! *)

import writer: Writer;
import conv: Conv;

let wOut = writer.output;
let printInt(x: Int): Ok =
    begin
        writer.putString(wOut conv.int(x));
        writer.putString(wOut "\n")
    end;

let printBool(b: Bool): Ok =
    begin
        writer.putString(wOut conv.bool(b));
        writer.putString(wOut "\n")
    end;

Let Day = Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end;
Let WeekDay = Variant mon: Int tue: Int wed: Int thu: Int fri: Int end;

let isMon(d: Day): Bool = d?mon;
let w: WeekDay = variant mon of WeekDay with 1 end;
printBool(isMon(w));

let getDayCode(d: Day): Int =
    case d
        when mon with c then c
        when tue with c then c
        when wed with c then c
        when thu with c then c
        when fri with c then c
        else 0
    end;

printInt(getDayCode(w));
let friDay: WeekDay = variant fri of WeekDay with 5 end;
printInt(getDayCode(friDay));
