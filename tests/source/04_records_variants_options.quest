(* Records, Options, Variants, and Arrays Test *)

Let Color = Option
    red
    green
    blue with intensity: Int end
end;

let c = option red of Color end;

let colorCode(col: Color): Int =
    case col
        when red then 1
        when green then 2
        when blue with b: Tuple intensity: Int end then b.intensity
        else 0
    end;

Let PointRec = Record
    x: Int
    y: Int
end;

let p = record
    x = 10
    y = 20
end;

let px = p.x;

let arr1 = array of 1 2 3 4 5 end;
let arr2 = array of(10 0);
let first = arr1[0];
