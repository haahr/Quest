(* Expressions and Control Flow Test *)

let x = 10;
let y = 20;

let sum = x + y * 2;
let boolVal = {x < y} andif {{x <> 0} orif {y is 20}};

let testIf(n: Int): Int =
    if n < 0 then
        0 - n
    elsif n is 0 then
        0
    else
        n
    end;

let testLoop(): Ok =
    begin
        let var i = 0;
        while i < 10 do
            i := i + 1
        end;

        loop
            if i is 20 then
                exit
            else
                i := i + 1
            end
        end;

        for k = 1 upto 5 do
            i := i + k
        end;

        for k = 5 downto 1 do
            i := i - k
        end;

        ok
    end;
