(* Standard library: Searching and sorting operations (util/sort) *)

import util/sort : util/Sort;
import collections/vector : collections/Vector;
import util/maybe : util/Maybe;
import writer: Writer;
import conv: Conv;

let wOut = writer.output;

let printInt(n: Int): Ok =
    begin
        writer.putString(wOut conv.int(n));
        writer.putString(wOut " ");
    end;

let printBool(b: Bool): Ok =
    begin
        writer.putString(wOut conv.bool(b));
        writer.putString(wOut " ");
    end;

let printString(s: String): Ok =
    begin
        writer.putString(wOut s);
        writer.putString(wOut " ");
    end;

let printNewline(dummy: Int): Ok =
    writer.putString(wOut "\n");

(* 1. Comparators *)
printInt(sort.intCompare(10 20));
printInt(sort.intCompare(20 20));
printInt(sort.intCompare(30 20));
printInt(sort.stringCompare("apple" "banana"));
printInt(sort.stringCompare("apple" "apple"));
printInt(sort.stringCompare("banana" "apple"));
let revInt = sort.reverse(:Int sort.intCompare);
printInt(revInt(10 20));
printInt(revInt(20 10));
printNewline(0);

(* 2. Bisection Right on Array *)
(* Array: [10, 20, 20, 20, 30, 40] *)
let arr1 = array of(6 0);
arr1[0] := 10;
arr1[1] := 20;
arr1[2] := 20;
arr1[3] := 20;
arr1[4] := 30;
arr1[5] := 40;

printInt(sort.bisectRight(:Int arr1 5 sort.intCompare));
printInt(sort.bisectRight(:Int arr1 10 sort.intCompare));
printInt(sort.bisectRight(:Int arr1 20 sort.intCompare));
printInt(sort.bisectRight(:Int arr1 25 sort.intCompare));
printInt(sort.bisectRight(:Int arr1 40 sort.intCompare));
printInt(sort.bisectRight(:Int arr1 50 sort.intCompare));
printNewline(0);

(* 3. Bisection Left on Array *)
printInt(sort.bisectLeft(:Int arr1 5 sort.intCompare));
printInt(sort.bisectLeft(:Int arr1 10 sort.intCompare));
printInt(sort.bisectLeft(:Int arr1 20 sort.intCompare));
printInt(sort.bisectLeft(:Int arr1 25 sort.intCompare));
printInt(sort.bisectLeft(:Int arr1 40 sort.intCompare));
printInt(sort.bisectLeft(:Int arr1 50 sort.intCompare));
printNewline(0);

(* 4. Exact Binary Search on Array *)
let s1 = sort.binarySearch(:Int arr1 20 sort.intCompare);
printBool(maybe.isSome(:Int s1));
printInt(maybe.unwrap(:Int s1));
let s2 = sort.binarySearch(:Int arr1 25 sort.intCompare);
printBool(maybe.isNone(:Int s2));
printNewline(0);

(* 5. Bisection & Binary Search on Vector *)
let vec1 = vector.new(:Int);
vector.append(:Int vec1 10);
vector.append(:Int vec1 20);
vector.append(:Int vec1 20);
vector.append(:Int vec1 30);

printInt(sort.bisectRightVector(:Int vec1 20 sort.intCompare));
printInt(sort.bisectLeftVector(:Int vec1 20 sort.intCompare));
let sv1 = sort.binarySearchVector(:Int vec1 30 sort.intCompare);
printBool(maybe.isSome(:Int sv1));
printInt(maybe.unwrap(:Int sv1));
let sv2 = sort.binarySearchVector(:Int vec1 99 sort.intCompare);
printBool(maybe.isNone(:Int sv2));
printNewline(0);

(* 6. Array In-Place Sort *)
let toSort = array of(8 0);
toSort[0] := 50;
toSort[1] := 10;
toSort[2] := 40;
toSort[3] := 20;
toSort[4] := 10;
toSort[5] := 30;
toSort[6] := 20;
toSort[7] := 50;

sort.sort(:Int toSort sort.intCompare);
for i = 0 upto 7 do
    printInt(toSort[i]);
end;
printNewline(0);

(* 7. Non-destructive sorted on Array *)
let original = array of(4 0);
original[0] := 9;
original[1] := 3;
original[2] := 7;
original[3] := 1;

let sortedArr = sort.sorted(:Int original sort.intCompare);
for i = 0 upto 3 do
    printInt(original[i]);
end;
printString("|");
for i = 0 upto 3 do
    printInt(sortedArr[i]);
end;
printNewline(0);

(* 8. Vector Sort & sortedVector *)
let vec2 = vector.new(:String);
vector.append(:String vec2 "banana");
vector.append(:String vec2 "apple");
vector.append(:String vec2 "cherry");
vector.append(:String vec2 "date");

let vecSorted = sort.sortedVector(:String vec2 sort.stringCompare);
for i = 0 upto {vector.length(:String vecSorted) - 1} do
    printString(vector.get(:String vecSorted i));
end;
printNewline(0);

let revStr = sort.reverse(:String sort.stringCompare);
sort.sortVector(:String vec2 revStr);
for i = 0 upto {vector.length(:String vec2) - 1} do
    printString(vector.get(:String vec2 i));
end;
printNewline(0);
