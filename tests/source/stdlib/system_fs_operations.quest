import system: System;
import writer: Writer;
import conv: Conv;

let printBool(b: Bool): Ok =
    begin
        writer.putString(writer.output conv.bool(b));
        writer.putString(writer.output "\n");
    end;

let printInt(n: Int): Ok =
    begin
        writer.putString(writer.output conv.int(n));
        writer.putString(writer.output "\n");
    end;

let printString(s: String): Ok =
    begin
        writer.putString(writer.output s);
        writer.putString(writer.output "\n");
    end;

(* 1. Test isFile and isDirectory on known paths *)
printBool(system.isFile("runtime/quest_runtime.h"));
printBool(system.isDirectory("runtime/quest_runtime.h"));
printBool(system.isFile("runtime"));
printBool(system.isDirectory("runtime"));
printBool(system.isFile("does_not_exist_abc_123.txt"));
printBool(system.isDirectory("does_not_exist_abc_123.txt"));

(* 2. Test directory creation, navigation, file operations *)
let testDir = "tmp_system_fs_test";
if system.fileExists(testDir) then
    system.removeDirectory(testDir);
end;

system.makeDirectory(testDir);
printBool(system.isDirectory(testDir));

let subDir = "tmp_system_fs_test/nested/deep";
system.makeDirectory(subDir);
printBool(system.isDirectory(subDir));

(* 3. Test creating a file, renaming it, and removing it *)
let fileA = "tmp_system_fs_test/nested/fileA.txt";
let w = writer.file(fileA);
writer.putString(w "hello world\n");
writer.close(w);

printBool(system.isFile(fileA));

let fileB = "tmp_system_fs_test/nested/fileB.txt";
system.renameFile(fileA fileB);
printBool(system.fileExists(fileA));
printBool(system.isFile(fileB));

system.removeFile(fileB);
printBool(system.fileExists(fileB));

(* 4. Test listDirectory *)
let subFile1 = "tmp_system_fs_test/nested/deep/file1.txt";
let w1 = writer.file(subFile1);
writer.putString(w1 "1");
writer.close(w1);

let subFile2 = "tmp_system_fs_test/nested/deep/file2.txt";
let w2 = writer.file(subFile2);
writer.putString(w2 "2");
writer.close(w2);

let entries = system.listDirectory(subDir);
printInt(arrayOp.size(entries));
printString(arrayOp.get(:String entries 0));
printString(arrayOp.get(:String entries 1));

system.removeFile(subFile1);
system.removeFile(subFile2);
system.removeDirectory(subDir);
system.removeDirectory("tmp_system_fs_test/nested");

(* 5. Test currentDirectory and changeDirectory *)
let origCwd = system.currentDirectory();
system.changeDirectory(testDir);
let newCwd = system.currentDirectory();
printBool(string.equal(origCwd newCwd));
system.changeDirectory(origCwd);
printBool(string.equal(origCwd system.currentDirectory()));

system.removeDirectory(testDir);
printBool(system.fileExists(testDir));

(* 6. Test exception on removing non-existent file *)
try
    begin
        system.removeFile("does_not_exist_xyz_999.txt");
        printString("FAIL: should have raised")
    end
when system.error then
    printString("CAUGHT: system.error")
end;
