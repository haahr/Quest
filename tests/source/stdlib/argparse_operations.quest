import
    util/argParse : util/ArgParse
    util/strutil : util/Strutil
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    writer: Writer
    conv: Conv
;

let printStr(s: String): Ok =
    begin
        writer.putString(writer.output s);
        writer.putString(writer.output "\n");
    end;

let printBool(b: Bool): Ok =
    printStr(conv.bool(b));

let printInt(n: Int): Ok =
    printStr(conv.int(n));

(* 1. Basic parser setup *)
let p = argParse.new("questc" "Quest Compiler Driver");
argParse.addFlag(p "echo" "-e --echo" "Echo compilation steps");
argParse.addString(p "output" "-o --output" "a.out" "Output file path");
let phases = array of "parse" "typecheck" "codegen" end;
argParse.addChoice(p "phase" "-p --phase" phases "codegen" "Stop after phase");
argParse.addInt(p "optLevel" "-O" 2 "Optimization level");
argParse.addMulti(p "include" "-I --include" "Search path directory");
argParse.addPositional(p "source" "Source file to compile");

(* 2. Test Help message formatting *)
let helpText = argParse.formatHelp(p);
printBool(strutil.contains(helpText "Usage: questc [options] source"));
printBool(strutil.contains(helpText "Echo compilation steps"));
printBool(strutil.contains(helpText "choices: parse, typecheck, codegen"));

(* 3. Parsing standard arguments with defaults *)
let args1 = array of "main.quest" end;
let r1 = argParse.parse(p args1);
printBool(argParse.getBool(r1 "echo"));
printStr(argParse.getStringOr(r1 "output" ""));
printStr(argParse.getStringOr(r1 "phase" ""));
printInt(argParse.getIntOr(r1 "optLevel" 0));
printInt(vector.length(:String argParse.getMulti(r1 "include")));

let pos1 = argParse.positionals(r1);
printInt(vector.length(:String pos1));
printStr(vector.get(:String pos1 0));

(* 4. Parsing flags, options, attached options, choices, and multi *)
let args2 = array of
    "-e"
    "-o" "myprog"
    "--phase=typecheck"
    "-O" "3"
    "-I" "lib"
    "-Iextra/lib"
    "src1.quest"
    "src2.quest"
    "--"
    "target_arg1"
    "target_arg2"
end;
let r2 = argParse.parse(p args2);
printBool(argParse.getBool(r2 "echo"));
printStr(argParse.getStringOr(r2 "output" ""));
printStr(argParse.getStringOr(r2 "phase" ""));
printInt(argParse.getIntOr(r2 "optLevel" 0));

let inc2 = argParse.getMulti(r2 "include");
printInt(vector.length(:String inc2));
printStr(vector.get(:String inc2 0));
printStr(vector.get(:String inc2 1));

let pos2 = argParse.positionals(r2);
printInt(vector.length(:String pos2));
printStr(vector.get(:String pos2 0));
printStr(vector.get(:String pos2 1));

let target2 = argParse.targetArgs(r2);
printInt(vector.length(:String target2));
printStr(vector.get(:String target2 0));
printStr(vector.get(:String target2 1));

(* 5. Error handling: unrecognized option *)
try
    let bad1Args = array of "--unknown" end;
    let bad1 = argParse.parse(p bad1Args);
    printStr("FAILED: should have raised on --unknown");
when argParse.error then
    printStr("CAUGHT: unrecognized option error");
end;

(* 6. Error handling: invalid choice *)
try
    let bad2Args = array of "--phase" "invalid_phase" end;
    let bad2 = argParse.parse(p bad2Args);
    printStr("FAILED: should have raised on invalid choice");
when argParse.error then
    printStr("CAUGHT: invalid choice error");
end;

(* 7. Error handling: missing argument for option *)
try
    let bad3Args = array of "-o" end;
    let bad3 = argParse.parse(p bad3Args);
    printStr("FAILED: should have raised on missing arg");
when argParse.error then
    printStr("CAUGHT: missing argument error");
end;

(* 8. Error handling: invalid integer *)
try
    let bad4Args = array of "-O" "not_a_number" end;
    let bad4 = argParse.parse(p bad4Args);
    printStr("FAILED: should have raised on invalid int");
when argParse.error then
    printStr("CAUGHT: invalid integer error");
end;

