(* Standard Library: Polymorphic Hash Set implementation
 *
 * Implements a set data structure backed by collections/hashMap(A, Ok).
 * Preserves insertion order during iteration.
 *)

module hashSet : HashSet
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    word: Word
export
    Let T = Fun(A::TYPE) Tuple
        map: hashMap.T(A Ok)
        equal: All(a1: A a2: A) Bool
        hash: All(a: A) word.T
    end;

    let newWithCapacity(A::TYPE)(capacity: Int equal: All(a1: A a2: A) Bool hash: All(a: A) word.T): T(A) =
        tuple
            let map = hashMap.newWithCapacity(:A :Ok capacity equal hash)
            let equal = equal
            let hash = hash
        end;

    let new(A::TYPE)(equal: All(a1: A a2: A) Bool hash: All(a: A) word.T): T(A) =
        tuple
            let map = hashMap.new(:A :Ok equal hash)
            let equal = equal
            let hash = hash
        end;

    let size(A::TYPE)(s: T(A)): Int =
        hashMap.size(s.map);

    let empty(A::TYPE)(s: T(A)): Bool =
        hashMap.empty(s.map);

    let contains(A::TYPE)(s: T(A) elem: A): Bool =
        hashMap.contains(s.map elem);

    let insert(A::TYPE)(s: T(A) elem: A): Bool =
        hashMap.insert(s.map elem ok);

    let delete(A::TYPE)(s: T(A) elem: A): Bool =
        maybe.isSome(hashMap.delete(s.map elem));

    let clear(A::TYPE)(s: T(A)): Ok =
        hashMap.clear(s.map);

    let elements(A::TYPE)(s: T(A)): vector.T(A) =
        hashMap.keys(s.map);

    let forEach(A::TYPE)(s: T(A) action: All(elem: A) Ok): Ok =
        begin
            let elems = hashMap.keys(s.map);
            let n = vector.length(elems);
            if n > 0 then
                for i = 0 upto {n - 1} do
                    action(vector.get(elems i));
                end;
            end;
            ok
        end;

    let copy(A::TYPE)(s: T(A)): T(A) =
        begin
            let res = newWithCapacity(size(s) s.equal s.hash);
            let elems = elements(s);
            let n = vector.length(elems);
            if n > 0 then
                for i = 0 upto {n - 1} do
                    insert(res vector.get(elems i));
                end;
            end;
            res
        end;

    let union(A::TYPE)(s1: T(A) s2: T(A)): T(A) =
        begin
            let res = newWithCapacity({size(s1) + size(s2)} s1.equal s1.hash);
            let e1 = elements(s1);
            let n1 = vector.length(e1);
            if n1 > 0 then
                for i = 0 upto {n1 - 1} do
                    insert(res vector.get(e1 i));
                end;
            end;
            let e2 = elements(s2);
            let n2 = vector.length(e2);
            if n2 > 0 then
                for i = 0 upto {n2 - 1} do
                    insert(res vector.get(e2 i));
                end;
            end;
            res
        end;

    let intersection(A::TYPE)(s1: T(A) s2: T(A)): T(A) =
        begin
            let primary = if size(s1) <= size(s2) then s1 else s2 end;
            let secondary = if size(s1) <= size(s2) then s2 else s1 end;
            let res = newWithCapacity(size(primary) s1.equal s1.hash);
            let elems = elements(primary);
            let n = vector.length(elems);
            if n > 0 then
                for i = 0 upto {n - 1} do
                    let item = vector.get(elems i);
                    if contains(secondary item) then
                        insert(res item);
                    end;
                end;
            end;
            res
        end;

    let difference(A::TYPE)(s1: T(A) s2: T(A)): T(A) =
        begin
            let res = newWithCapacity(size(s1) s1.equal s1.hash);
            let elems = elements(s1);
            let n = vector.length(elems);
            if n > 0 then
                for i = 0 upto {n - 1} do
                    let item = vector.get(elems i);
                    if not(contains(s2 item)) then
                        insert(res item);
                    end;
                end;
            end;
            res
        end;

    let isSubset(A::TYPE)(s1: T(A) s2: T(A)): Bool =
        begin
            if size(s1) > size(s2) then
                false
            else
                let elems = elements(s1);
                let n = vector.length(elems);
                let var subset = true;
                let var i = 0;
                while {i < n} /\ subset do
                    if not(contains(s2 vector.get(elems i))) then
                        subset := false;
                    else
                        i := i + 1;
                    end;
                end;
                subset
            end
        end;

    let equal(A::TYPE)(s1: T(A) s2: T(A)): Bool =
        if size(s1) == size(s2) then
            isSubset(s1 s2)
        else
            false
        end;
end;
